# ===== Local-only secrets (NEVER commit) =====
# Real Gizwits PRODUCT_KEY / PRODUCT_SECRET are kept here locally so you can
# restore them before building/flashing. This file is ignored by git.
*.local.txt
*.local.h
*.secret
gizwits_credentials.local.txt

